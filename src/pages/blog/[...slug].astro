---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { postFilter } from "@/utils/postFilter";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  // Only published posts get a redirect; drafts never existed publicly.
  return posts.filter(postFilter).map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const target = getRelativeLocaleUrl(
  Astro.currentLocale ?? "zh-CN",
  `posts/${slug}`,
);

return Astro.redirect(target, 301);
---
